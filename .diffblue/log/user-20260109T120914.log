package finos.traderx.tradeprocessor.repository;

import static org.mockito.Mockito.mock;
import com.diffblue.cover.annotations.ManagedByDiffblue;
import com.diffblue.cover.annotations.MethodsUnderTest;
import finos.traderx.tradeprocessor.model.Trade;
import finos.traderx.tradeprocessor.model.TradeSide;
import finos.traderx.tradeprocessor.model.TradeState;
import java.time.LocalDate;
import java.time.ZoneOffset;
import java.util.Date;
import org.hibernate.engine.spi.SessionDelegatorBaseImpl;
import org.hibernate.engine.spi.SessionImplementor;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.springframework.data.jpa.repository.support.SimpleJpaRepository;

class TradeRepositoryDiffblueTest {
  /**
   * Test.
   *
   * <p>Method under test: {@link TradeRepository#delete(Object)}
   */
  @Test
  @DisplayName("Test")
  @Tag("ContributionFromDiffblue")
  @ManagedByDiffblue
  @MethodsUnderTest({"void org.springframework.data.repository.CrudRepository.delete(Object)"})
  void test() {
    // Arrange
    Class<Trade> domainClass = Trade.class;
    SessionDelegatorBaseImpl entityManager =
        new SessionDelegatorBaseImpl(mock(SessionImplementor.class));

    SimpleJpaRepository<Trade, Integer> simpleJpaRepository =
        new SimpleJpaRepository<>(domainClass, entityManager);

    Trade trade = new Trade();
    trade.setAccountId(1);
    trade.setCreated(
        Date.from(LocalDate.of(1970, 1, 1).atStartOfDay().atZone(ZoneOffset.UTC).toInstant()));
    trade.setId("42");
    trade.setQuantity(1);
    trade.setSecurity("Security");
    trade.setSide(TradeSide.Buy);
    trade.setState(TradeState.New);
    trade.setUpdated(
        Date.from(LocalDate.of(1970, 1, 1).atStartOfDay().atZone(ZoneOffset.UTC).toInstant()));

    // Act
    simpleJpaRepository.delete(trade);
  }
}

