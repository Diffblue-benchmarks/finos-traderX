class AccountUserRepositoryDiffblueTest {
  /**
   * Test.
   *
   * <p>Method under test: {@link AccountUserRepository#existsById(Object)}
   */
  @Test
  @DisplayName("Test")
  @Tag("ContributionFromDiffblue")
