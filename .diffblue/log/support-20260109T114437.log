    trade.setSide(TradeSide.Buy);
    trade.setState(TradeState.New);
    trade.setUpdated(
        Date.from(LocalDate.of(1970, 1, 1).atStartOfDay().atZone(ZoneOffset.UTC).toInstant()));

    // Act
    simpleJpaRepository.delete(trade);
  }
}

